void Turn_On_LED(int LED)
{
    Turn_Off_All_LEDs();

    switch (LED)
    {
        case 0:
            // LED0 -> PA1
            GPIOA->ODR |= (1 << 1);
            break;

        case 1:
            // LED1 -> PA0
            GPIOA->ODR |= (1 << 0);
            break;

        case 2:
            // LED2 -> PC7
            GPIOC->ODR |= (1 << 7);
            break;

        case 3:
            // LED3 -> PC8
            GPIOC->ODR |= (1 << 8);
            break;
    }
}
