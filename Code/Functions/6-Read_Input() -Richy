int Read_Buttons(void)
{
    uint32_t idr = GPIOB->IDR;

    // SW5 (PB8) -> LED0 (Index 0)
    if (idr & (1 << 8))
    {
        Wait_For_Release();
        return 0;
    }

    // SW4 (PB9) -> LED1 (Index 1)
    if (idr & (1 << 9))
    {
        Wait_For_Release();
        return 1;
    }

    // SW3 (PB10) -> LED2 (Index 2)
    if (idr & (1 << 10))
    {
        Wait_For_Release();
        return 2;
    }

    // SW2 (PB11) -> LED3 (Index 3)
    if (idr & (1 << 11))
    {
        Wait_For_Release();
        return 3;
    }

    return -1;
}
