void Game_Over_Display(void)
{
    char text[17];

    Turn_Off_All_LEDs();

    // Display GAME OVER on LCD
    LCD_Clear();
    if (GameOver == 1)
        LCD_Print("GAME OVER");
    else
        LCD_Print("YOU WIN");

    // Display final Score on LCD
    LCD_SetCursor(1, 0);
    sprintf(text, "Score: %d", Score);
    LCD_Print(text);

    HAL_Delay(1500);
}
