int Sequence[20];
int Score = 0;
int PlayerPosition = 0;
int PlayerInput = -1;
volatile int GameOver = 0;
int StartGame = 0;
int Round = 1;
int RandomLED;

int Button2; int Button3; int Button4; int Button5;

int LED_Delay = 500;
int Button_Delay = 25;
char Keypad_GetKey(void);

// The main function, and the entry point of the program
int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    LCD_Init();
    Initialize_Game();

    while (1)
    {
        LCD_Clear();
        LCD_Print("Simon Says");
        LCD_SetCursor(1, 0);
        LCD_Print("Press # to start");

        // Wait until '#' is pressed
        while (Keypad_GetKey() != '#') { }

        srand(HAL_GetTick());
        GameOver = 0;

        while (GameOver == 0 && Round <= 20)
        {
            Generate_Sequence();
            Display_Sequence();

            PlayerPosition = 0;

            while (PlayerPosition < Round && GameOver == 0)
            {
                Check_Input();
            }

            if (GameOver == 0)
            {
                Score = Round;
                Round++;
                HAL_Delay(500);
            }
        }

        Game_Over_Display();

        // Wait for '#' to restart
        while (Keypad_GetKey() != '#') { }

        Reset_Game();
    }
}



