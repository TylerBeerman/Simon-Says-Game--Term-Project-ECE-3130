void Write_SR_LCD(uint8_t temp) {
    uint8_t mask = 0b10000000;
    for (int i = 0; i < 8; i++) {
        if ((temp & mask) == 0) {
            GPIOB->ODR &= ~(1 << 5);     // PB5 = Data low
        } else {
            GPIOB->ODR |= (1 << 5);      // PB5 = Data high
        }
        
        // Pulse Shift Clock (PA5)
        GPIOA->ODR &= ~(1 << 5);
        HAL_Delay(1);
        GPIOA->ODR |= (1 << 5);
        HAL_Delay(1);
        
        mask = mask >> 1;
    }
    
    // Latch Clock (PA10)
    GPIOA->ODR |= (1 << 10);
    GPIOA->ODR &= ~(1 << 10);
}

void LCD_nibble_write(uint8_t temp, uint8_t s) {
    if (s == 0) { /* Command mode: RS = 0 */
        temp = temp & 0xF0;
        temp = temp | 0x02; /* RS=0, EN=1 */
        Write_SR_LCD(temp);
        temp = temp & 0xFD; /* EN=0 */
        Write_SR_LCD(temp);
    } else {      /* Data mode: RS = 1 */
        temp = temp & 0xF0;
        temp = temp | 0x03; /* RS=1, EN=1 */
        Write_SR_LCD(temp);
        temp = temp & 0xFD; /* EN=0 */
        Write_SR_LCD(temp);
    }
}

void LCD_Command(uint8_t code) {
    LCD_nibble_write(code & 0xF0, 0);       // High nibble
    LCD_nibble_write((code << 4) & 0xF0, 0); // Low nibble
    HAL_Delay(2);
}

void LCD_WriteChar(uint8_t code) {
    LCD_nibble_write(code & 0xF0, 1);       // High nibble
    LCD_nibble_write((code << 4) & 0xF0, 1); // Low nibble
    HAL_Delay(1);
}

void LCD_Print(char *str) {
    int i = 0;
    while (str[i] != '\0') {
        LCD_WriteChar(str[i]);
        i++;
    }
}

void LCD_Clear(void) {
    LCD_Command(0x01); // Clear display instruction
    HAL_Delay(2);
}

void LCD_SetCursor(uint8_t row, uint8_t col) {
    uint8_t address = (row == 0) ? (0x80 + col) : (0xC0 + col);
    LCD_Command(address);
}

void LCD_Init(void) {
    HAL_Delay(50); // Power-on wait time
    
    // initialization sequence
    LCD_nibble_write(0x30, 0);
    HAL_Delay(5);
    LCD_nibble_write(0x30, 0);
    HAL_Delay(1);
    LCD_nibble_write(0x30, 0);
    HAL_Delay(1);
    LCD_nibble_write(0x20, 0); // Set to 4-bit mode
    HAL_Delay(1);

    LCD_Command(0x28); // 4-bit, 2-line, 5x8 font
    LCD_Command(0x0C); // Display ON, Cursor OFF
    LCD_Command(0x06); // Increment cursor
    LCD_Clear();
}

char Keypad_GetKey(void) {
    const char keymap[4][4] = {
        {'1', '2', '3', 'A'},
        {'4', '5', '6', 'B'},
        {'7', '8', '9', 'C'},
        {'*', '0', '#', 'D'}
    };

    const uint16_t colPins[4] = {GPIO_PIN_1, GPIO_PIN_2, GPIO_PIN_3, GPIO_PIN_4};
    const uint16_t rowPins[4] = {GPIO_PIN_8, GPIO_PIN_9, GPIO_PIN_10, GPIO_PIN_11};

    for (int col = 0; col < 4; col++) {
        // Set current column HIGH
        HAL_GPIO_WritePin(GPIOB, colPins[col], GPIO_PIN_SET);

        for (volatile int d = 0; d < 50; d++);

        for (int row = 0; row < 4; row++) {
            if (HAL_GPIO_ReadPin(GPIOB, rowPins[row]) == GPIO_PIN_SET) {
                // Wait for release (debounce)
                while (HAL_GPIO_ReadPin(GPIOB, rowPins[row]) == GPIO_PIN_SET);
                // Reset column LOW before returning
                HAL_GPIO_WritePin(GPIOB, colPins[col], GPIO_PIN_RESET);
                return keymap[row][col];
            }
        }

        // Set column LOW
        HAL_GPIO_WritePin(GPIOB, colPins[col], GPIO_PIN_RESET);
    }

    return 0; // No key pressed
}



