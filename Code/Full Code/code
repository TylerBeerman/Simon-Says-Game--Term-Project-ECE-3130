// this is the start of our game functions
void Initialize_Game(void)
{
    Round = 1;
    Score = 0;
    PlayerPosition = 0;
    PlayerInput = -1;
    GameOver = 0;
}

void Generate_Sequence(void)
{
    RandomLED = rand() % 4;

    Sequence[Round - 1] = RandomLED;
}

void Display_Sequence(void)
{
    int i;
    char text[17];

    LCD_Clear();
    sprintf(text, "Round %d", Round);
    LCD_Print(text);
    LCD_SetCursor(1, 0);
    LCD_Print("Watch closely");

    HAL_Delay(750);

    for (i = 0; i < Round; i++)
    {
        Turn_On_LED(Sequence[i]);

        HAL_Delay(LED_Delay);

        Turn_Off_All_LEDs();

        HAL_Delay(250);
    }

    LCD_Clear();
    LCD_Print("Your turn");
}

void Turn_Off_All_LEDs(void)
{
    // Clear PA0 (LED1) and PA1 (LED0)
    GPIOA->ODR &= ~((1 << 0) | (1 << 1));

    // Clear PC7 (LED2) and PC8 (LED3)
    GPIOC->ODR &= ~((1 << 7) | (1 << 8));
}

void Turn_On_LED(int LED)
{
    Turn_Off_All_LEDs();

    switch (LED)
    {
        case 0:
            // LED0 -> PA1
            GPIOA->ODR |= (1 << 1);
            break;

        case 1:
            // LED1 -> PA0
            GPIOA->ODR |= (1 << 0);
            break;

        case 2:
            // LED2 -> PC7
            GPIOC->ODR |= (1 << 7);
            break;

        case 3:
            // LED3 -> PC8
            GPIOC->ODR |= (1 << 8);
            break;
    }
}

int Read_Buttons(void)
{
    uint32_t idr = GPIOB->IDR;

    // SW5 (PB8) -> LED0 (Index 0)
    if (idr & (1 << 8))
    {
        Wait_For_Release();
        return 0;
    }

    // SW4 (PB9) -> LED1 (Index 1)
    if (idr & (1 << 9))
    {
        Wait_For_Release();
        return 1;
    }
		

    // SW3 (PB10) -> LED2 (Index 2)
    if (idr & (1 << 10))
    {
        Wait_For_Release();
        return 2;
    }

    // SW2 (PB11) -> LED3 (Index 3)
    if (idr & (1 << 11))
    {
        Wait_For_Release();
        return 3;
    }

    return -1;
}

void Wait_For_Release(void)
{
    HAL_Delay(Button_Delay);

    while ((GPIOB->IDR & 0x0F00) != 0) { }

    HAL_Delay(Button_Delay);
}

void Check_Input(void)
{
    PlayerInput = Read_Buttons();

    if (PlayerInput != -1)
    {
        Turn_On_LED(PlayerInput);
        HAL_Delay(Button_Delay + 150);
        Turn_Off_All_LEDs();

        if (PlayerInput == Sequence[PlayerPosition])
        {
            PlayerPosition++;
        }
        else
        {
            GameOver = 1;
        }
    }
}

void Game_Over_Display(void)
{
    char text[17];

    Turn_Off_All_LEDs();

    // Display GAME OVER on LCD
    LCD_Clear();
    if (GameOver == 1)
        LCD_Print("GAME OVER");
    else
        LCD_Print("YOU WIN");

    // Display final Score on LCD
    LCD_SetCursor(1, 0);
    sprintf(text, "Score: %d", Score);
    LCD_Print(text);

    HAL_Delay(1500);
}

void Reset_Game(void)
{
    Initialize_Game();
    Turn_Off_All_LEDs();
}

void Write_SR_LCD(uint8_t temp) {
    uint8_t mask = 0b10000000;
    for (int i = 0; i < 8; i++) {
        if ((temp & mask) == 0) {
            GPIOB->ODR &= ~(1 << 5);     // PB5 = Data low
        } else {
            GPIOB->ODR |= (1 << 5);      // PB5 = Data high
        }
        
        // Pulse Shift Clock (PA5)
        GPIOA->ODR &= ~(1 << 5);
        HAL_Delay(1);
        GPIOA->ODR |= (1 << 5);
        HAL_Delay(1);
        
        mask = mask >> 1;
    }
    
    // Latch Clock (PA10)
    GPIOA->ODR |= (1 << 10);
    GPIOA->ODR &= ~(1 << 10);
}

void LCD_nibble_write(uint8_t temp, uint8_t s) {
    if (s == 0) { /* Command mode: RS = 0 */
        temp = temp & 0xF0;
        temp = temp | 0x02; /* RS=0, EN=1 */
        Write_SR_LCD(temp);
        temp = temp & 0xFD; /* EN=0 */
        Write_SR_LCD(temp);
    } else {      /* Data mode: RS = 1 */
        temp = temp & 0xF0;
        temp = temp | 0x03; /* RS=1, EN=1 */
        Write_SR_LCD(temp);
        temp = temp & 0xFD; /* EN=0 */
        Write_SR_LCD(temp);
    }
}

void LCD_Command(uint8_t code) {
    LCD_nibble_write(code & 0xF0, 0);       // High nibble
    LCD_nibble_write((code << 4) & 0xF0, 0); // Low nibble
    HAL_Delay(2);
}

void LCD_WriteChar(uint8_t code) {
    LCD_nibble_write(code & 0xF0, 1);       // High nibble
    LCD_nibble_write((code << 4) & 0xF0, 1); // Low nibble
    HAL_Delay(1);
}

void LCD_Print(char *str) {
    int i = 0;
    while (str[i] != '\0') {
        LCD_WriteChar(str[i]);
        i++;
    }
}

void LCD_Clear(void) {
    LCD_Command(0x01); // Clear display instruction
    HAL_Delay(2);
}

void LCD_SetCursor(uint8_t row, uint8_t col) {
    uint8_t address = (row == 0) ? (0x80 + col) : (0xC0 + col);
    LCD_Command(address);
}

void LCD_Init(void) {
    HAL_Delay(50); // Power-on wait time
    
    // initialization sequence
    LCD_nibble_write(0x30, 0);
    HAL_Delay(5);
    LCD_nibble_write(0x30, 0);
    HAL_Delay(1);
    LCD_nibble_write(0x30, 0);
    HAL_Delay(1);
    LCD_nibble_write(0x20, 0); // Set to 4-bit mode
    HAL_Delay(1);

    LCD_Command(0x28); // 4-bit, 2-line, 5x8 font
    LCD_Command(0x0C); // Display ON, Cursor OFF
    LCD_Command(0x06); // Increment cursor
    LCD_Clear();
}

void Game_Delay(uint32_t ms)
{
    uint32_t start = HAL_GetTick();
    while ((HAL_GetTick() - start < ms) && !GameOver)
    {
        // Breaks immediately if '*' sets GameOver = 1
    }
}

char Keypad_GetKey(void)
{
    const char keymap[4][4] = {
        {'1', '2', '3', 'A'},
        {'4', '5', '6', 'B'},
        {'7', '8', '9', 'C'},
        {'*', '0', '#', 'D'}
    };

    const uint16_t colPins[4] = {GPIO_PIN_1, GPIO_PIN_2, GPIO_PIN_3, GPIO_PIN_4};
    const uint16_t rowPins[4] = {GPIO_PIN_8, GPIO_PIN_9, GPIO_PIN_10, GPIO_PIN_11};

    // Temporarily disable PB11 interrupt during scanning
    HAL_NVIC_DisableIRQ(EXTI15_10_IRQn);

    char pressedKey = 0;

    for (int col = 0; col < 4; col++) {
        HAL_GPIO_WritePin(GPIOB, colPins[col], GPIO_PIN_SET);

        for (volatile int d = 0; d < 100; d++);

        for (int row = 0; row < 4; row++) {
            if (HAL_GPIO_ReadPin(GPIOB, rowPins[row]) == GPIO_PIN_SET) {
                // Wait for release
                while (HAL_GPIO_ReadPin(GPIOB, rowPins[row]) == GPIO_PIN_SET);
                pressedKey = keymap[row][col];
                HAL_GPIO_WritePin(GPIOB, colPins[col], GPIO_PIN_RESET);
                goto finish_scan;
            }
        }
        HAL_GPIO_WritePin(GPIOB, colPins[col], GPIO_PIN_RESET);
    }

finish_scan:
    // Restore Col 0 to HIGH so '*' is ready to trigger the interrupt
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_SET);
    
    // Clear any pending interrupt caused by scanning and re-enable
    __HAL_GPIO_EXTI_CLEAR_IT(GPIO_PIN_11);
    HAL_NVIC_EnableIRQ(EXTI15_10_IRQn);

    return pressedKey;
}

// Interrupt service routine for PB11
void EXTI15_10_IRQHandler(void)
{
    HAL_GPIO_EXTI_IRQHandler(GPIO_PIN_11);
}

// HAL Callback
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == GPIO_PIN_11)
    {
        // Drop Col 0 (PB1) LOW and see if PB11 follows it
        GPIOB->ODR &= ~(1 << 1);
        for (volatile int d = 0; d < 200; d++);   // short settle time (don't use HAL_Delay in an ISR)

        uint8_t starPressed = ((GPIOB->IDR & (1 << 11)) == 0);

        // Restore Col 0 HIGH so '*' can trigger again
        GPIOB->ODR |= (1 << 1);
        for (volatile int d = 0; d < 200; d++);

        // Restoring PB1 creates a new rising edge if '*' is still held, so clear it
        __HAL_GPIO_EXTI_CLEAR_IT(GPIO_PIN_11);

        if (starPressed)
        {
            GameOver = 1;
            Turn_Off_All_LEDs();
        }
    }
}



